APP_NAME="Gestión Institucional - Cristo Rey"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestion.cristorey.edu.ec

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=daily
LOG_LEVEL=error

# Conexión a la Base de Datos Institucional
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uecrey_produccion
DB_USERNAME=usuario_db
DB_PASSWORD=contrasena_segura_db

# Sesiones seguras
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Correo Institucional
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@cristorey.edu.ec
MAIL_PASSWORD=clave_de_aplicacion_correo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@cristorey.edu.ec"
MAIL_FROM_NAME="U.E.P. Cristo Rey"
